{
  "name": "rca-sda",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:setup": "prisma migrate deploy",
    "db:audit": "tsx scripts/audit-content.ts",
    "db:studio": "prisma studio",
    "ingest:all": "tsx scripts/ingest-all.ts",
    "ingest:bible": "tsx scripts/ingest-bible.ts",
    "ingest:kinyarwanda": "node scripts/parse-kinyarwanda.mjs && tsx scripts/ingest-kinyarwanda.ts",
    "ingest:kinyarwanda-hymns": "node scripts/parse-kinyarwanda-hymnal.mjs && tsx scripts/ingest-kinyarwanda-hymns.ts",
    "verify:kinyarwanda": "tsx scripts/ingest-kinyarwanda.ts --report",
    "verify:kinyarwanda-hymns": "node scripts/parse-kinyarwanda-hymnal.mjs --check",
    "ingest:hymns": "tsx scripts/ingest-hymns.ts",
    "ingest:quarter": "tsx scripts/sync-quarter.ts",
    "seed:catalog": "tsx scripts/seed-catalog.ts",
    "seed:admin": "tsx scripts/seed-admin.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^1.70.0",
    "next": "15.5.29",
    "prisma": "^6.19.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@opennextjs/cloudflare": "1.20.12",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "pdfjs-dist": "^4.10.38",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wrangler": "4.148.0"
  }
}
